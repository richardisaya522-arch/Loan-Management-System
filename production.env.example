# ===== ZABURI YA 23 MICROFINANCE - mazingira ya production (Flask) =====
# Nakili faili hili kuwa "production.env" kisha badilisha thamani.
# USIPANDE production.env wala .prod_secret_key kwenye GitHub.

# Siri ya session/CSRF. Acha imefungwa ili script itengeneze yenyewe
# na kuhifadhi kwenye .prod_secret_key (pia haipandi GitHub).
# SECRET_KEY=

# Weka 1 ukiwa kwenye HTTPS (inahitajika production halisi).
COOKIE_SECURE=1
# HSTS: weka 1 baada ya kuhakikisha HTTPS inafanya kazi vizuri.
HSTS=1
# Weka 1 KAMA iko nyuma ya reverse proxy moja (Caddy/nginx/IIS/Render/Fly).
TRUST_PROXY=1
# Domain halali, zikitenganishwa kwa koma. Mfano: lms.mfano.com
TRUSTED_HOSTS=lms.mfano.com

# Server isikike kwenye intaneti moja kwa moja; reverse proxy iwe mbele.
HOST=127.0.0.1
PORT=8000

# Muda wa ukimya kabla ya kutoa session (dakika).
SESSION_IDLE_MINUTES=30

# Password ya admin wa kwanza. Inatumika TU wakati database ni mpya.
# ADMIN_PASSWORD=BadilishaHiiSasa!2026
